set(CMAKE_CXX_LINK_EXECUTABLE "<CMAKE_LINKER> /nologo <OBJECTS> /out:<TARGET> /implib:<TARGET_IMPLIB> <LINK_FLAGS> <LINK_LIBRARIES>")
set(CMAKE_C_LINK_EXECUTABLE "${CMAKE_CXX_LINK_EXECUTABLE}")
set(CMAKE_CXX_CREATE_SHARED_LIBRARY "<CMAKE_LINKER> /nologo /dll <OBJECTS> /out:<TARGET> /implib:<TARGET_IMPLIB> <LINK_FLAGS> <LINK_LIBRARIES>")
set(CMAKE_CXX_CREATE_SHARED_MODULE "${CMAKE_CXX_CREATE_SHARED_LIBRARY}")
set(CMAKE_C_CREATE_SHARED_LIBRARY "${CMAKE_CXX_CREATE_SHARED_LIBRARY}")
set(CMAKE_C_CREATE_SHARED_MODULE "${CMAKE_CXX_CREATE_SHARED_LIBRARY}")
# Resources need C preprocessing without line markers (non-ASCII source paths) or a second pass.
set(CMAKE_RC_COMPILE_OBJECT "<CMAKE_COMMAND> -E cmake_llvm_rc <SOURCE> <OBJECT>.pp <CMAKE_C_COMPILER> /TC <DEFINES> -DRC_INVOKED <INCLUDES> <FLAGS> -E -Xclang -P -- <SOURCE> ++ <CMAKE_RC_COMPILER> /no-preprocess <DEFINES> <INCLUDES> <FLAGS> /fo <OBJECT> <OBJECT>.pp")
