set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
if(NOT DEFINED ENV{EPINIZER_LLVM_ROOT} OR NOT DEFINED ENV{EPINIZER_WINSDK})
  message(FATAL_ERROR "Set EPINIZER_LLVM_ROOT (LLVM bin parent) and EPINIZER_WINSDK (xwin splat root)")
endif()
file(TO_CMAKE_PATH "$ENV{EPINIZER_LLVM_ROOT}" EPINIZER_LLVM)
file(TO_CMAKE_PATH "$ENV{EPINIZER_WINSDK}" EPINIZER_SDK)
set(CMAKE_C_COMPILER "${EPINIZER_LLVM}/bin/clang-cl")
set(CMAKE_CXX_COMPILER "${EPINIZER_LLVM}/bin/clang-cl")
set(CMAKE_C_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_RC_COMPILER "${EPINIZER_LLVM}/bin/llvm-rc")
set(CMAKE_LINKER "${EPINIZER_LLVM}/bin/lld-link")
set(CMAKE_AR "${EPINIZER_LLVM}/bin/llvm-lib")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreaded)
set(EPINIZER_INCLUDES "/imsvc${EPINIZER_SDK}/crt/include /imsvc${EPINIZER_SDK}/sdk/include/ucrt /imsvc${EPINIZER_SDK}/sdk/include/shared /imsvc${EPINIZER_SDK}/sdk/include/um /imsvc${EPINIZER_SDK}/sdk/include/winrt")
set(CMAKE_C_FLAGS_INIT "${EPINIZER_INCLUDES}")
set(CMAKE_CXX_FLAGS_INIT "${EPINIZER_INCLUDES} /EHsc")
set(CMAKE_RC_FLAGS_INIT "/I${EPINIZER_SDK}/crt/include /I${EPINIZER_SDK}/sdk/include/ucrt /I${EPINIZER_SDK}/sdk/include/shared /I${EPINIZER_SDK}/sdk/include/um")
set(EPINIZER_LIBPATHS "/libpath:${EPINIZER_SDK}/crt/lib/x86_64 /libpath:${EPINIZER_SDK}/sdk/lib/ucrt/x86_64 /libpath:${EPINIZER_SDK}/sdk/lib/um/x86_64")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${EPINIZER_LIBPATHS} /manifest:embed")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${EPINIZER_LIBPATHS}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${EPINIZER_LIBPATHS}")
# LLD embeds manifests itself. Avoid CMake's Windows-only external mt.exe step.
set(CMAKE_USER_MAKE_RULES_OVERRIDE "${CMAKE_CURRENT_LIST_DIR}/windows-lld-rules.cmake")
set(CMAKE_FIND_ROOT_PATH "${EPINIZER_SDK}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
